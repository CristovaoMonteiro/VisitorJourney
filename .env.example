# Port the Express server listens on
PORT=3000

# MongoDB connection string. Never commit the real value.
# Atlas (recommended), one cluster with two databases:
#   development: mongodb+srv://<user>:<password>@<cluster>/visitor-journey-dev
#   production:  mongodb+srv://<user>:<password>@<cluster>/visitor-journey
# Local:         mongodb://127.0.0.1:27017/visitor-journey-dev
# No database at hand? Use `npm run dev:memory` instead of `npm run dev`.
MONGODB_URI=

# Optional: protect /dashboard and its API with HTTP Basic auth (any username).
# Leave empty for a public, read-only demo dashboard.
DASHBOARD_PASSWORD=

# Number of reverse proxies in front of the app (Render/Railway: 1).
# Leave empty when running locally.
TRUST_PROXY=
