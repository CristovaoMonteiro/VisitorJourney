{
  "name": "visitor-journey-dashboard",
  "version": "0.1.0",
  "description": "Fictional premium menswear store with privacy-first visitor tracking, segmentation and a journey dashboard.",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "dev:memory": "node --watch scripts/dev-memory.js",
    "images": "node scripts/build-images.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "chart.js": "4.4.7",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1"
  }
}
